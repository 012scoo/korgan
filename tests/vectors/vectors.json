  "ladder": [
    {
      "name": "Средняя зона: доверенные лица молчат, самоподтверждения нет",
      "scenario": 3,
      "steps": [
        {
          "do": "busy",
          "guardian": true,
          "second": true
        },
        {
          "do": "transfer",
          "rid": "repair",
          "amount": 120000
        },
        {
          "expect": {
            "zone": "yellow",
            "status": "HELD",
            "notified": [
              "guardian"
            ]
          }
        },
        {
          "do": "advance_to",
          "minute": 5.5
        },
        {
          "expect": {
            "notified": [
              "guardian",
              "second"
            ]
          }
        },
        {
          "do": "advance_to",
          "minute": 10.5
        },
        {
          "expect": {
            "not_notified": [
              "ward"
            ]
          }
        },
        {
          "do": "decide",
          "actor": "ward",
          "decision": "approve",
          "called": false,
          "error": "SELF_CONFIRM_UNAVAILABLE"
        },
        {
          "expect": {
            "status": "HELD"
          }
        }
      ]
    },
    {
      "name": "Средняя зона: никто не решил — отмена по сроку",
      "scenario": 3,
      "steps": [
        {
          "do": "busy",
          "guardian": true,
          "second": true
        },
        {
          "do": "transfer",
          "rid": "repair",
          "amount": 120000
        },
        {
          "do": "advance_to",
          "minute": 61
        },
        {
          "expect": {
            "status": "EXPIRED"
          }
        }
      ]
    },
    {
      "name": "Красная зона: нужны два подтверждения",
      "scenario": 1,
      "steps": [
        {
          "do": "sim",
          "call": "ended_unknown"
        },
        {
          "do": "transfer",
          "rid": "stranger",
          "amount": 480000
        },
        {
          "expect": {
            "zone": "red",
            "status": "HELD"
          }
        },
        {
          "do": "decide",
          "actor": "guardian",
          "decision": "approve",
          "result": "waiting"
        },
        {
          "expect": {
            "status": "HELD",
            "notified": [
              "guardian",
              "second"
            ]
          }
        },
        {
          "do": "decide",
          "actor": "second",
          "decision": "approve"
        },
        {
          "expect": {
            "status": "EXECUTED"
          }
        }
      ]
    },
    {
      "name": "Красная зона: второй молчит — сотрудник через 5 минут после первого",
      "scenario": 1,
      "steps": [
        {
          "do": "sim",
          "call": "ended_unknown"
        },
        {
          "do": "transfer",
          "rid": "stranger",
          "amount": 480000
        },
        {
          "do": "advance_to",
          "minute": 2
        },
        {
          "do": "decide",
          "actor": "guardian",
          "decision": "approve"
        },
        {
          "do": "advance_to",
          "minute": 6.5
        },
        {
          "expect": {
            "not_notified": [
              "operator"
            ]
          }
        },
        {
          "do": "advance_to",
          "minute": 7.5
        },
        {
          "expect": {
            "notified": [
              "guardian",
              "second",
              "operator"
            ]
          }
        }
      ]
    },
    {
      "name": "Один отказ останавливает",
      "scenario": 1,
      "steps": [
        {
          "do": "sim",
          "call": "ended_unknown"
        },
        {
          "do": "transfer",
          "rid": "stranger",
          "amount": 480000
        },
        {
          "do": "decide",
          "actor": "guardian",
          "decision": "reject"
        },
        {
          "expect": {
            "status": "REJECTED"
          }
        }
      ]
    },
    {
      "name": "Во время звонка перевод заблокирован (АРРФР)",
